#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
NVIM_DIR="$HOME/.config/nvim"
PACKAGE_DIR="$DOTFILES_DIR/nvim/.config/nvim"

log() {
  printf '%s\n' "$*"
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

# A fresh Omarchy install ships ~/.config/nvim already populated (from the
# omarchy-nvim package's /etc/skel copy) as real files, not symlinks — and
# several of our own paths (init.lua, lua/config/*, a few lua/plugins/*
# files copied from that same source) collide with it by name. Stow refuses
# to touch ANY of its files (not just the conflicting ones) when even one
# real, non-symlink file already sits where it wants to place a link, so
# those live files need backing up first — same pattern as
# bin/hypr/bootstrap-hyprland, generalized for nvim's nested tree.
backup_live_files() {
  mkdir -p "$NVIM_DIR"

  while IFS= read -r -d '' path; do
    local rel="${path#"$PACKAGE_DIR"/}"
    local live="$NVIM_DIR/$rel"

    if [[ -e "$live" && ! -L "$live" ]]; then
      # Stow folds an entire uncontested subtree into ONE directory symlink
      # rather than linking file-by-file. When that's happened, $live is
      # reached THROUGH a symlinked ancestor directory, so -L is false on
      # its own final path component even though it canonicalizes to the
      # exact same file as $path -- the repo's own copy, viewed via the
      # live path. Renaming it would rename the real repo file (this bit
      # us for real: a whole-tree fold on nvim turned this into a mass
      # rename of every tracked nvim config file). Skip anything that
      # already resolves to the package's own copy.
      if [[ "$(readlink -f "$live")" == "$(readlink -f "$path")" ]]; then
        continue
      fi

      local backup="$live.bak.$(date +%s)"
      log "Backing up live $rel -> $(basename "$backup")"
      mkdir -p "$(dirname "$backup")"
      mv "$live" "$backup"
    fi
  done < <(find "$PACKAGE_DIR" -type f -print0)
}

stow_nvim() {
  if have_cmd stow; then
    # link_omarchy_theme (below) points this one file at Omarchy's theme
    # instead of our repo copy, which makes stow see it as "not owned by
    # stow" on the next run and abort stowing the WHOLE package. Since
    # link_omarchy_theme reruns after every stow_nvim anyway, it's safe to
    # drop here first -- guarded by -L so a genuine live file (not yet a
    # symlink) is left alone for backup_live_files to handle instead.
    [[ -L "$NVIM_DIR/lua/plugins/theme.lua" ]] && rm -f "$NVIM_DIR/lua/plugins/theme.lua"

    log "Stowing nvim from $DOTFILES_DIR"
    # --no-folding: without it, stow collapses an entire uncontested subtree
    # (here, all of ~/.config/nvim) into ONE directory symlink rather than
    # linking file-by-file. link_omarchy_theme below needs to replace a
    # single leaf (lua/plugins/theme.lua) with an unrelated symlink; through
    # a folded ancestor that leaf's live path resolves straight into this
    # repo, so ln -sfn there would edit the repo's own tracked file instead
    # of the live tree (same hazard backup_live_files works around above,
    # hit for real once already). Per-file symlinks make every leaf path
    # independent, so replacing one never touches the others.
    (cd "$DOTFILES_DIR" && stow --no-folding nvim)
  else
    log "GNU Stow not found — skipping"
  fi
}

# Vanilla omarchy-nvim ships lua/plugins/theme.lua as a symlink straight
# into ~/.local/state/omarchy/current/theme/neovim.lua, so lazy.nvim's own
# built-in change-detector (which already polls every file under
# lua/plugins/ and fires User LazyReload on a change) picks up theme
# switches for free — no extra watcher code needed. Our theme.lua is a
# real file (stow needs one; a symlink here would be dangling and break
# `{ import = "plugins" }` on non-Omarchy machines like the Mac), so on
# Omarchy we replace the stow-created symlink with the same direct link
# vanilla uses. This has to rerun after every stow_nvim, since stowing
# resets it back to pointing at our repo's copy.
link_omarchy_theme() {
  local omarchy_theme_file="$HOME/.local/state/omarchy/current/theme/neovim.lua"

  if have_cmd omarchy && [[ -f "$omarchy_theme_file" ]]; then
    log "Linking theme.lua to Omarchy's current theme"
    ln -sfn "$omarchy_theme_file" "$NVIM_DIR/lua/plugins/theme.lua"
  fi
}

sync_plugins() {
  if have_cmd nvim; then
    log "Syncing lazy.nvim plugins (headless)"
    nvim --headless "+Lazy! sync" +qa 2>&1 | tail -n +1
  else
    log "nvim not found — skipping plugin sync"
  fi
}

main() {
  backup_live_files
  stow_nvim
  link_omarchy_theme
  sync_plugins
  log "nvim bootstrap complete"
}

main "$@"
